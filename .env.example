# D1 API 配置示例
# 复制此文件为 .env.local 并填充实际值

# Worker URL - 部署到 Cloudflare 后的地址
# 示例: https://family-tree.wolfife.workers.dev
VITE_D1_API_BASE_URL=https://your-worker-url.workers.dev

# 服务端新增环境变量（在 Worker 侧配置，不在前端 .env 中使用）：
# - SYSADMIN_PASSWORD_PBKDF2: 仅首次初始化/旧管理员过渡使用，格式 pbkdf2_sha256$100000$<salt_hex>$<hash_hex>
# - SYSADMIN_PASSWORD_PBKDF2_NEXT: 可选，初始化/过渡密码的轮换窗口；不是独立密码的备用密码
# - ALLOW_LEGACY_API_TOKEN_AUTH: 生产保持未设置或 false，开启会绕过账号密码验证
# - SESSION_TTL_HOURS: 会话有效期小时数（默认 24）
# 所有角色登录都需要独立密码；旧成员须管理员设置临时密码，详见 docs/guides/login.md
