{
  "name": "family-tree-app",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "workspaces": [
    "server",
    "vendor/vben/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck:server && vue-tsc -b && vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "preview:local": "npm run build && npm run build:server && npm start",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "verify:part-data-v2": "tsx scripts/verify-part-data-v2.ts"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@vben-core/design": "5.7.0",
    "@vben-core/layout-ui": "5.7.0",
    "ant-design-vue": "^4.2.6",
    "echarts": "^6.1.0",
    "sql.js": "^1.15.2",
    "tesseract.js": "^7.0.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@iconify/tailwind4": "^1.2.3",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/node": "^26.6.5",
    "@types/nprogress": "^0.2.3",
    "@types/sortablejs": "^1.15.9",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "sass": "^1.99.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "undici": "^7.30.1",
    "esbuild": "^0.28.2"
  }
}
