{
  "name": "family-tree-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "clean:wrangler": "node -e \"import('node:fs').then(fs=>fs.rmSync('.wrangler',{recursive:true,force:true}))\"",
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "npm run build && wrangler dev --remote",
    "preview:local": "npm run build && wrangler dev",
    "predeploy": "npm run clean:wrangler",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:part-data-v2": "tsx scripts/verify-part-data-v2.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "echarts": "^6.1.0",
    "sql.js": "^1.15.2",
    "tesseract.js": "^7.0.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@types/node": "^26.6.5",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "undici": "^7.30.1",
    "esbuild": "^0.28.2"
  }
}
